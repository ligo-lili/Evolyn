{
  "name": "agent-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Durable execution harness on top of Pi Agent Runtime: run/checkpoint/recovery, trace/replay, experience memory, trace-driven skill learning.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "agent-harness": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "harness": "node --disable-warning=ExperimentalWarning dist/cli/index.js",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format:check": "prettier --check src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval:memory": "node --disable-warning=ExperimentalWarning scripts/eval-memory.mjs",
    "eval:coding": "node --disable-warning=ExperimentalWarning scripts/eval-coding.mjs",
    "e2e:memory-hybrid": "node --disable-warning=ExperimentalWarning scripts/e2e-memory-hybrid.mjs",
    "chaos": "node --disable-warning=ExperimentalWarning scripts/chaos.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@huggingface/transformers": "^3.0.0",
    "typebox": "1.3.27",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "eslint": "^9.39.4",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.0.0"
  },
  "exports": {
    "./dist/index.js": "./dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts"
}
