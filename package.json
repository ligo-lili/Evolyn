    "test": "vitest run",
    "harness": "node --disable-warning=ExperimentalWarning dist/cli/index.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@huggingface/transformers": "^3.0.0",
    "typebox": "1.3.27",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
